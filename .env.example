# ใช้ 3100 เพราะพอร์ต 3000 ถูกใช้โดยเซิร์ฟเวอร์ student-api ของแล็บอยู่แล้ว
PORT=3100

# ค่าเชื่อมต่อ MySQL (ต้องตรงกับ docker-compose.yml)
# ใช้พอร์ต 3307 เพราะ 3306 ถูกใช้โดย container ของ student-api ในสัปดาห์ที่ 5 อยู่แล้ว
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=music_library

# API ภายนอก (iTunes Search API) - ค่าด้านล่างคือค่า default ในโค้ด
# เปลี่ยน EXTERNAL_API_BASE_URL เพื่อจำลองสถานการณ์ล้มเหลวได้โดยไม่ต้องแก้โค้ด
EXTERNAL_API_BASE_URL=https://itunes.apple.com
EXTERNAL_API_TIMEOUT_MS=3000
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_DELAY_MS=500
